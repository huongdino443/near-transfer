<UserControl x:Class="NearTransfer.Windows.TransferProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NearTransfer.Windows"
             Background="{StaticResource WindowBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">
    <Grid Margin="42,28" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PageTitle" Text="Đang gửi tập tin"
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource PanelRaisedBrush}"
                CornerRadius="18" Padding="20" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="104" Height="104" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource SurfaceHighBrush}" StrokeThickness="8"/>
                    <Path x:Name="ProgressArc" Fill="Transparent"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <Ellipse x:Name="ProgressRingComplete"
                             Stroke="{StaticResource AccentBrush}" StrokeThickness="8"
                             Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%"
                               FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryHeading" Text="DỮ LIỆU ĐÃ GỬI"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="TransferredText" Text="0 B / 0 B"
                               Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TransferDetailsText" Text="0 mục · 00:00"
                               Margin="0,3,0,0" FontSize="13"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="CurrentFileText"
                               Text="Đang chờ thiết bị xác nhận..."
                               Margin="0,9,0,0" FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NỘI DUNG" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="FileCountText" Grid.Column="1" Text="0 mục"
                       FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </Grid>

        <ScrollViewer x:Name="FilesScrollViewer" Grid.Row="3"
                      CanContentScroll="False"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      local:SmoothScrollBehavior.IsEnabled="True">
            <ItemsControl x:Name="FilesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelRaisedBrush}"
                                CornerRadius="14" Padding="14" Margin="0,0,0,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="15"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                           Margin="12,0,0,0" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding StatusText}"
                                           Margin="0,5,0,0" FontSize="13"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap"/>
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2"
                                             Value="{Binding Progress}" Maximum="100"
                                             Height="4" Margin="0,9,0,0"
                                             Visibility="{Binding ProgressVisibility}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource SurfaceHighBrush}"
                                             BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="CloseButton" Grid.Row="4" Content="Đóng"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Stretch" MinHeight="54"
                Margin="0,14,0,0" Visibility="Collapsed"
                Click="CloseButton_Click"/>
    </Grid>
</UserControl>