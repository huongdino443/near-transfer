<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>NearTransfer</AssemblyName>
    <RootNamespace>NearTransfer.Windows</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\NearTransfer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NearTransfer.Core\NearTransfer.Core.csproj" />
    <Resource Include="Assets\NearTransfer.ico" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>