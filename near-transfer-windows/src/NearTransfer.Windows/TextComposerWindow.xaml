<Window x:Class="NearTransfer.Windows.TextComposerWindow"
        Icon="pack://application:,,,/Assets/NearTransfer.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập văn bản"
        Width="620" Height="470"
        MinWidth="520" MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nhập văn bản" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14"
                   Text="Tin nhắn được gửi riêng, không gộp với file. Giới hạn 256 KiB."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <TextBox x:Name="MessageInput" Grid.Row="2"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 SpellCheck.IsEnabled="True"
                 TextChanged="MessageInput_TextChanged"/>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ByteCountText" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <Button Grid.Column="1" Content="Hủy" MinWidth="92" Margin="0,0,9,0"
                    Style="{StaticResource QuietButton}" Click="Cancel_Click"/>
            <Button x:Name="AddButton" Grid.Column="2"
                    Content="Thêm vào hàng chờ" MinWidth="164"
                    Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
        </Grid>
    </Grid>
</Window>