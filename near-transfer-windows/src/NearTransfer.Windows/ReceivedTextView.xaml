<UserControl x:Class="NearTransfer.Windows.ReceivedTextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NearTransfer.Windows"
             Background="{StaticResource WindowBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">
    <Grid Margin="42,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="58" Height="58" CornerRadius="14"
                    Background="{StaticResource PanelRaisedBrush}"
                    HorizontalAlignment="Left">
                <TextBlock Text="Aa" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="SenderText" Margin="0,14,0,0"
                       FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="đã gửi cho bạn một tin nhắn:"
                       Margin="0,5,0,0" FontSize="14"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,12"
                Background="{StaticResource PanelRaisedBrush}"
                CornerRadius="14" Padding="18">
            <ScrollViewer CanContentScroll="False"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          local:SmoothScrollBehavior.IsEnabled="True">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                           FontSize="14" LineHeight="21"/>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="ActionStatusText" Grid.Row="2"
                   VerticalAlignment="Bottom" Margin="0,0,0,12"
                   Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Lưu thành tệp .txt"
                    Style="{StaticResource SurfaceButton}"
                    MinHeight="54" Margin="0,0,6,0"
                    Click="Save_Click"/>
            <Button Grid.Column="1" Content="Sao chép"
                    Style="{StaticResource PrimaryButton}"
                    MinHeight="54" Margin="6,0,0,0"
                    Click="Copy_Click"/>
        </Grid>
    </Grid>
</UserControl>