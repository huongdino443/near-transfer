<Window x:Class="NearTransfer.Windows.ManualAddressWindow"
        Icon="pack://application:,,,/Assets/NearTransfer.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Địa chỉ máy nhận"
        Width="480" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Địa chỉ máy nhận" FontSize="21"
                   FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,19"
                   Text="Nhập IP trên màn hình của thiết bị kia."
                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"/>
        <Grid Grid.Row="2">
            <TextBox x:Name="AddressBox"
                     FontSize="16" MinHeight="62"
                     VerticalContentAlignment="Center"
                     TextChanged="AddressBox_TextChanged"/>
            <TextBlock x:Name="AddressPlaceholder"
                       Text="Ví dụ: 192.168.1.20"
                       Margin="16,0,16,0"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                   VerticalAlignment="Top" FontSize="12"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,18,0,0">
            <Button Content="Hủy" MinWidth="92" Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource SurfaceButton}" Click="Cancel_Click"/>
            <Button Content="Tiếp tục" MinWidth="112"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
        </StackPanel>
    </Grid>
</Window>